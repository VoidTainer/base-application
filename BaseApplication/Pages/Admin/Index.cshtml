@page
@model BaseApplication.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Админ-панель";
}

<h1>Админ-панель</h1>

<div class="grid">
    <a class="card" asp-page="/Admin/Bookings"><h3>@Model.TotalBookings</h3><p>Всего бронирований</p></a>
    <a class="card" asp-page="/Admin/Bookings"><h3>@Model.PendingBookings</h3><p>Ожидают подтверждения</p></a>
    <a class="card" asp-page="/Admin/Services"><h3>@Model.TotalServices</h3><p>Услуг</p></a>
    <a class="card" asp-page="/Admin/Reviews"><h3>@Model.PendingReviews / @Model.TotalReviews</h3><p>Отзывов на модерации</p></a>
    <a class="card" asp-page="/Admin/Messages"><h3>@Model.UnreadMessages</h3><p>Непрочитанных сообщений</p></a>
</div>

<h2>Последние бронирования</h2>
@if (!Model.RecentBookings.Any())
{
    <div class="card"><p>Пока нет бронирований.</p></div>
}
else
{
    <table class="table">
        <thead><tr><th>Дата</th><th>Время</th><th>Гостей</th><th>Услуги</th><th>Статус</th></tr></thead>
        <tbody>
            @foreach (var b in Model.RecentBookings)
            {
                <tr>
                    <td>@b.Date.ToString("dd.MM.yyyy")</td>
                    <td>@b.StartTime.ToString(@"hh\:mm")</td>
                    <td>@b.Guests</td>
                    <td>@(b.BookingServices.Any() ? string.Join(", ", b.BookingServices.Select(x => x.Service?.Name)) : "—")</td>
                    <td><partial name="_BookingStatus" model="b.Status" /></td>
                </tr>
            }
        </tbody>
    </table>
}