@page
@model BaseApplication.Pages.Admin.BookingsModel
@{
    ViewData["Title"] = "Бронирования — админка";
}

<h1>Бронирования</h1>
@if (TempData["Msg"] != null)
{
    <div class="alert">@TempData["Msg"]</div>
}

<div class="card" style="margin-bottom:1rem;">
    <a asp-page="/Admin/Bookings" class="btn @(string.IsNullOrEmpty(Model.Filter) ? "primary" : "outline")">Все</a>
    <a asp-page="/Admin/Bookings" asp-route-filter="Pending" class="btn @(Model.Filter == "Pending" ? "primary" : "outline")">Ожидают</a>
    <a asp-page="/Admin/Bookings" asp-route-filter="Confirmed" class="btn @(Model.Filter == "Confirmed" ? "primary" : "outline")">Подтверждены</a>
    <a asp-page="/Admin/Bookings" asp-route-filter="Cancelled" class="btn @(Model.Filter == "Cancelled" ? "primary" : "outline")">Отменены</a>
</div>

@if (!Model.Items.Any())
{
    <div class="card"><p>Бронирований нет.</p></div>
}
else
{
    <table class="table">
        <thead>
            <tr><th>#</th><th>Дата</th><th>Время</th><th>Гостей</th><th>Услуги</th><th>Комментарий</th><th>Статус</th><th>Действия</th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Items)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Date.ToString("dd.MM.yyyy")</td>
                    <td>@b.StartTime.ToString(@"hh\:mm")</td>
                    <td>@b.Guests</td>
                    <td>@(b.BookingServices.Any() ? string.Join(", ", b.BookingServices.Select(x => x.Service?.Name)) : "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(b.Comment) ? "—" : b.Comment)</td>
                    <td>
                        @switch (b.Status)
                        {
                            case BookingStatus.Pending:
                                <span class="badge pending">Ожидает</span>
                                break;
                            case BookingStatus.Confirmed:

                                <span class="badge confirmed">Подтверждено</span>
                                break;
                            case BookingStatus.Cancelled:

                                <span class="badge cancelled">Отменено</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (b.Status == BookingStatus.Pending)
                        {
                            <form method="post" asp-page-handler="Confirm" asp-route-id="@b.Id" class="inline">
                                <button class="btn-link">Подтвердить</button>
                            </form>
                            <span> | </span>
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@b.Id" class="inline">
                                <button class="btn-link">Отменить</button>
                            </form>
                        }
                        else if (b.Status == BookingStatus.Confirmed)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@b.Id" class="inline">
                                <button class="btn-link">Отменить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}