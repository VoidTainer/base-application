@page
@model BaseApplication.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}
<h1>Вход</h1>
<form method="post" class="card form">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="error"></div>
    }
    <input type="hidden" asp-for="ReturnUrl" />
    <label>Email<input asp-for="Input.Email" type="email" required /></label>
    <label>Пароль<input asp-for="Input.Password" type="password" required /></label>
    <button class="btn primary" type="submit">Войти</button>
</form>
<p><a asp-page="/Account/Register">Регистрация</a></p>
<p class="small">Тест: admin@base.ru / Admin123 · manager@base.ru / Manager123 · user@base.ru / User1234</p>